<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard — Hale ʻŌhiʻa Lehua</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background-color: #0f0f0f;
            background-image: radial-gradient(ellipse at top, #1a0a00 0%, #0f0f0f 70%);
            font-family: 'Georgia', serif;
            color: #e8e0d4;
        }

        header {
            background: #1a1a1a;
            border-bottom: 1px solid #3d2b1f;
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .header-left h1 {
            font-size: 1.2rem;
            color: #c8a882;
            letter-spacing: 0.05em;
        }

        .site-link {
            font-size: 1.2rem;
            color: #c8a882;
            letter-spacing: 0.05em;
            text-decoration: none;
        }

        .site-link:hover { color: #e8e0d4; 
        }

        .header-left p {
            font-size: 0.8rem;
            color: #6b5a4e;
            font-style: italic;
            margin-top: 0.2rem;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .admin-email {
            font-size: 0.85rem;
            color: #a08878;
        }

        .logout-btn {
            padding: 0.5rem 1rem;
            background: transparent;
            border: 1px solid #3d2b1f;
            border-radius: 6px;
            color: #a08878;
            font-family: 'Georgia', serif;
            font-size: 0.85rem;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s;
        }

        .logout-btn:hover {
            border-color: #c8a882;
            color: #c8a882;
        }

        main {
            max-width: 1100px;
            margin: 2.5rem auto;
            padding: 0 2rem;
        }

        .welcome {
            margin-bottom: 2rem;
        }

        .welcome h2 {
            font-size: 1.5rem;
            color: #c8a882;
        }

        .welcome p {
            color: #6b5a4e;
            font-size: 0.9rem;
            margin-top: 0.3rem;
            font-style: italic;
        }

        .stats-bar {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: #1a1a1a;
            border: 1px solid #3d2b1f;
            border-radius: 8px;
            padding: 1rem 1.5rem;
            flex: 1;
            text-align: center;
        }

        .stat-card .number {
            font-size: 2rem;
            color: #c8a882;
        }

        .stat-card .label {
            font-size: 0.8rem;
            color: #6b5a4e;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: 0.25rem;
        }

        .section-title {
            font-size: 1rem;
            color: #a08878;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid #3d2b1f;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #1a1a1a;
            border: 1px solid #3d2b1f;
            border-radius: 8px;
            overflow: hidden;
        }

        thead {
            background: #2a1a10;
        }

        th {
            padding: 0.85rem 1rem;
            text-align: left;
            font-size: 0.8rem;
            color: #a08878;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: normal;
        }

        td {
            padding: 0.85rem 1rem;
            font-size: 0.9rem;
            border-top: 1px solid #2a1a10;
            color: #e8e0d4;
        }

        tr:hover td {
            background: #1f1f1f;
        }

        .island-badge {
            display: inline-block;
            padding: 0.2rem 0.6rem;
            border-radius: 20px;
            font-size: 0.75rem;
            background: #2d6a4f22;
            border: 1px solid #2d6a4f;
            color: #52b788;
        }

        .review-count {
            color: #c8a882;
            font-size: 0.85rem;
        }

        @media (max-width: 600px) {
            header {
                flex-direction: column;
                gap: 1rem;
                align-items: flex-start;
            }

            .stats-bar {
                flex-direction: column;
            }

            table {
                font-size: 0.8rem;
            }

            th,
            td {
                padding: 0.6rem 0.75rem;
            }
        }
    </style>
</head>

<body>
    <header>
        <div class="header-left">
            <a href="http://localhost:5173" class="site-link">🌺 Hale ʻŌhiʻa Lehua</a>
            <p>Admin Dashboard</p>  </div>
        <div class="header-right">
            <span class="admin-email">
                <%= user.email %>
            </span>
            <a href="/admin/logout" class="logout-btn">Sign Out</a>
        </div>
    </header>

    <main>
        <div class="welcome">
            <h2>Welcome back, <%= user.email.split('@')[0] %>
            </h2>
            <p>Manage your Hale ʻŌhiʻa Lehua properties below.</p>
        </div>

        <div class="stats-bar">
            <div class="stat-card">
                <div class="number">
                    <%= properties.length %>
                </div>
                <div class="label">Properties</div>
            </div>
            <div class="stat-card">
                <div class="number">
                    <%= properties.reduce((sum, p)=> sum + (p.reviews ? p.reviews.length : 0), 0) %>
                </div>
                <div class="label">Total Reviews</div>
            </div>
            <div class="stat-card">