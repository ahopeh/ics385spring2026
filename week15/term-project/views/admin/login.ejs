<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login — Hale ʻŌhiʻa Lehua</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #0f0f0f;
            background-image: radial-gradient(ellipse at top, #1a0a00 0%, #0f0f0f 70%);
            font-family: 'Georgia', serif;
            color: #e8e0d4;
        }

        .login-card {
            background: #1a1a1a;
            border: 1px solid #3d2b1f;
            border-radius: 12px;
            padding: 2.5rem 2rem;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
        }

        .property-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .property-header .lehua {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .property-header h1 {
            font-size: 1.3rem;
            color: #c8a882;
            letter-spacing: 0.05em;
        }

        .property-header p {
            font-size: 0.85rem;
            color: #6b5a4e;
            margin-top: 0.25rem;
            font-style: italic;
        }

        .error-message {
            background: #2a0f0f;
            border: 1px solid #8b2020;
            border-radius: 6px;
            padding: 0.75rem 1rem;
            margin-bottom: 1.25rem;
            font-size: 0.875rem;
            color: #e07070;
        }

        .form-group {
            margin-bottom: 1.25rem;
        }

        label {
            display: block;
            font-size: 0.85rem;
            color: #a08878;
            margin-bottom: 0.4rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        input[type="email"],
        input[type="password"] {
            width: 100%;
            padding: 0.75rem 1rem;
            background: #0f0f0f;
            border: 1px solid #3d2b1f;
            border-radius: 6px;
            color: #e8e0d4;
            font-size: 1rem;
            transition: border-color 0.2s;
        }

        input[type="email"]:focus,
        input[type="password"]:focus {
            outline: none;
            border-color: #c8a882;
        }

        input::placeholder {
            color: #4a3a30;
        }

        .submit-btn {
            width: 100%;
            padding: 0.85rem;
            background: #2d6a4f;
            border: none;
            border-radius: 6px;
            color: #e8e0d4;
            font-size: 1rem;
            font-family: 'Georgia', serif;
            letter-spacing: 0.05em;
            cursor: pointer;
            margin-top: 0.5rem;
            transition: background 0.2s;
        }

        .submit-btn:hover {
            background: #3a8a65;
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 1.5rem;
            font-size: 0.8rem;
            color: #6b5a4e;
            text-decoration: none;
        }

        .back-link:hover {
            color: #c8a882;
        }

        @media (max-width: 480px) {
            .login-card {
                margin: 1rem;
                padding: 2rem 1.5rem;
            }
        }

        .divider {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin: 1.25rem 0;
  color: #4a3a30;
  font-size: 0.85rem;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: #3d2b1f;
}

.google-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  width: 100%;
  padding: 0.85rem;
  background: #1a1a1a;
  border: 1px solid #3d2b1f;
  border-radius: 6px;
  color: #e8e0d4;
  font-size: 1rem;
  font-family: 'Georgia', serif;
  text-decoration: none;
  transition: border-color 0.2s;
  margin-bottom: 1rem;
}

.google-btn:hover {
  border-color: #c8a882;
}
    </style>
</head>

<body>
    <div class="login-card">
        <div class="property-header">
            <div class="lehua">🌺</div>
            <h1>Hale ʻŌhiʻa Lehua</h1>
            <p>Admin Portal</p>
        </div>

        <% if (error) { %>
            <div class="error-message" role="alert">
                <%= error %>
            </div>
            <% } %>

                <form action="/admin/login" method="POST">
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="admin@haleohialehua.com" required
                            autocomplete="email" />
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" placeholder="••••••••" required
                            autocomplete="current-password" />
                    </div>

                    <button type="submit" class="submit-btn">Sign In</button>
                </form>

                <div class="divider">
                    <span>or</span>
                </div>
                
                <a href="/auth/google" class="google-btn">
                    <svg width="18" height="18" viewBox="0 0 48 48">
                        <path fill="#EA4335"
                            d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                        <path fill="#4285F4"
                            d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                        <path fill="#FBBC05"
                            d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                        <path fill="#34A853"
                            d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                    </svg>
                    Sign in with Google              
                </a>

                <a href="http://localhost:5173" class="back-link">← Back to Hale ʻŌhiʻa Lehua</a>
    </div>
</body>

</html>